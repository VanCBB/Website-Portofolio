{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/work-experience", "destination": "/work-experience.html" },
    { "source": "/project", "destination": "/project.html" },
    { "source": "/certificate", "destination": "/certificate.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
